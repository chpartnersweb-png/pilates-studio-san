---
import { Image, getImage } from 'astro:assets';
import Icon from '../components/Icon.astro';
import StudioPhoto from '../components/StudioPhoto.astro';
import logo from '../assets/logo-transparent.png';
import { links, navigation, photos, gallery, prices } from '../data/studio';
import '../styles/global.css';

const title = 'Pilates studio San｜自由が丘のプライベートピラティス';
const description = '整うからだ、ピラティスで健康に。自由が丘駅徒歩5分、九品仏駅徒歩7分のPilates studio San。完全プライベート空間で、お一人おひとりのお身体や目的に合わせたピラティスセッションを。';
const socialImage = Astro.site ? new URL('/ogp.jpg', Astro.site).href : '/ogp.jpg';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const mobileHero = await getImage({ src: gallery[0].image, width: 1000, format: 'webp' });
const mapQuery = encodeURIComponent('Pilates studio San 東京都世田谷区奥沢7-7-21 カーサアビエルタ');
const studioPhotos = gallery.slice(0, 6);
const portraits = gallery.slice(6);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e8e9e7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Pilates studio San" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content="Pilates studio Sanのロゴ" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600&family=Noto+Serif+JP:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>

    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero__intro">
        <h1 id="hero-title"><span class="hero__line"><span data-hero-line>整うからだ、</span></span><span class="hero__line"><span data-hero-line>ピラティスで健康に。</span></span></h1>
        <p class="hero__note" data-hero-reveal>自由が丘の<br />プライベートピラティス</p>
      </div>
      <div class="hero__visual" data-hero-visual>
        <picture>
          <source media="(max-width: 767px) and (orientation: portrait)" srcset={mobileHero.src} />
          <Image class="hero__image" src={photos.machineLesson} alt="Pilates studio Sanのプライベートスタジオとピラティスセッション" width={1568} height={1044} widths={[640, 960, 1280, 1568]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
        </picture>
        <a class="hero__access" href="#access" data-hero-reveal><span>自由が丘駅 徒歩5分<br />九品仏駅 徒歩7分</span><Icon name="down" /></a>
      </div>
    </section>

    <header class="site-header" data-header>
      <a class="brand" href="#top" aria-label="Pilates studio San トップへ"><Image class="brand__logo" src={logo} width={72} height={72} alt="" loading="eager" /><span>Pilates studio <b>San</b></span></a>
      <nav class="desktop-nav" aria-label="メインナビゲーション">{navigation.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
      <a class="header-reserve" href={links.reserve} target="_blank" rel="noopener noreferrer">ご予約<span class="link-square"><Icon name="external" /></span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="メニューを開く" data-menu-open><span></span><span></span></button>
    </header>

    <dialog class="mobile-menu" id="mobile-menu" aria-label="ナビゲーションメニュー" data-mobile-menu data-lenis-prevent>
      <div class="mobile-menu__top"><a class="brand" href="#top"><Image class="brand__logo" src={logo} width={72} height={72} alt="" /><span>Pilates studio <b>San</b></span></a><button class="icon-button" type="button" aria-label="メニューを閉じる" data-menu-close><Icon name="close" /></button></div>
      <nav aria-label="モバイルナビゲーション">{navigation.map((item) => <a href={item.href}>{item.label}<Icon name="arrow" /></a>)}</nav>
      <a class="solid-link" href={links.reserve} target="_blank" rel="noopener noreferrer">レッスンを予約する<Icon name="external" /></a>
      <a class="inline-link" href={links.line} target="_blank" rel="noopener noreferrer">LINEでお問い合わせ<Icon name="external" /></a>
    </dialog>

    <main id="main">
      <section class="about" id="about" aria-labelledby="about-title">
        <div class="about__image photograph"><Image src={photos.studioDetail} alt="グリーンとSanのサインを飾ったスタジオの一角" width={1706} height={960} widths={[480, 800, 1200]} sizes="(max-width: 767px) 82vw, 50vw" format="webp" data-parallax /></div>
        <div class="about__words"><p class="small-label" data-reveal>Sanについて</p><h2 class="reading-title" id="about-title" data-reveal>自分のからだと、<br />ていねいに向き合う。</h2><div class="reading-copy" data-reveal><p>忙しい日々の中で、<br />からだの声に耳を澄ませる時間を。</p><p>Pilates studio Sanは、自由が丘にある<br />完全プライベートのピラティススタジオです。</p><p>誰かと比べず、急がずに。<br />一人ひとりのお身体や目的に合わせて、<br />無理なく続けることで、より健康に。</p><p>そんなピラティスの時間を、<br />ここで過ごしてみませんか。</p></div></div>
      </section>

      <section class="lesson" id="lesson" aria-labelledby="lesson-title">
        <div class="lesson__words"><p class="small-label" data-reveal>レッスン</p><h2 class="reading-title" id="lesson-title" data-reveal>からだも、目的も。<br />あなたに合わせて。</h2><div class="reading-copy" data-reveal><p>周りを気にせず、自分に集中する。<br />お身体の状態や目指すことに合わせて、<br />マシンやマットを使うプライベートセッション。</p><p>大切にしているのは、<br />ご自身のペースで、心地よく続けられること。<br />日々の健康につながる時間をお届けします。</p></div><dl class="lesson__facts" data-reveal><div><dt>空間</dt><dd>完全プライベート</dd></div><div><dt>セッション</dt><dd>お身体と目的に合わせた個別レッスン</dd></div><div><dt>対象</dt><dd>大人の方</dd></div></dl><a class="inline-link" href="#price" data-reveal>レッスン料金を見る<Icon name="arrow" /></a></div>
        <div class="lesson__image photograph"><Image src={photos.matLesson} alt="マットの上でバランスを取りながら行うピラティスのエクササイズ" width={1205} height={1359} widths={[480, 720, 1000]} sizes="(max-width: 767px) 88vw, 50vw" format="webp" data-parallax /></div>
      </section>

      <section class="studio section-shell" id="studio" aria-labelledby="studio-title">
        <div class="section-directory"><h2 id="studio-title">スタジオの風景</h2><p>からだを動かす場所。<br />自分のための、小さな居場所。</p><a class="inline-link" href={links.instagram} target="_blank" rel="noopener noreferrer">Instagram<Icon name="external" /></a><p class="section-directory__note">写真はタップして拡大できます。</p></div>
        <div class="studio__photos">{studioPhotos.map((photo) => <StudioPhoto photo={photo} />)}</div>
      </section>

      <section class="instructor section-shell" id="instructor" aria-labelledby="instructor-title">
        <div class="section-directory"><h2 id="instructor-title">インストラクター</h2><p>一人ひとりと向き合い、<br />健やかな毎日を支える。</p></div>
        <div class="profile"><div class="profile__main"><div class="profile__portrait photograph" data-reveal><Image src={photos.instructor} alt="Pilates studio San インストラクター 山口千恵子" width={960} height={1706} widths={[480, 720, 960]} sizes="(max-width: 767px) 70vw, 32vw" format="webp" /></div><div class="profile__intro" data-reveal><p class="profile__role">Pilates studio San</p><h3>山口 千恵子</h3><p class="profile__roman">Chieko Yamaguchi</p><p class="profile__message">一人ひとりのお身体や目的に合わせて。<br />あなたの健やかな毎日を、<br />ピラティスを通してサポートします。</p></div></div><div class="profile__qualifications" data-reveal><h4>資格・認定</h4><ul><li><span>PEAK PILATES</span>Full Comprehensive Certification</li><li><span>BODY CONTROL PILATES</span>産後のためのリカバリーピラティス</li><li><span>公益財団法人 健康・体力づくり事業財団</span>健康運動指導士</li></ul></div><div class="profile__moments">{portraits.map((photo) => <StudioPhoto photo={photo} caption={false} />)}</div><p class="profile__moments-caption">スタジオでの日々。</p></div>
      </section>

      <section class="price section-shell" id="price" aria-labelledby="price-title">
        <div class="section-directory"><h2 id="price-title">レッスン料金</h2><p>ご自身のペースで、<br />続けられるかたちを。</p></div>
        <div class="price__content"><p class="price__lead" data-reveal>1回ごとのレッスンと、継続して通うための回数券。<br />ライフスタイルに合わせてお選びください。</p><table class="price-table" data-reveal><caption class="sr-only">プライベートレッスンの料金と有効期限</caption><thead><tr><th scope="col">レッスン</th><th scope="col">有効期限</th><th scope="col">料金</th></tr></thead><tbody>{prices.map((price) => <tr><th scope="row">{price.title}<small>{price.count !== '1' && price.perSession}</small></th><td>{price.count === '1' ? '—' : price.validity.replace('有効期限 ', '')}</td><td><span>{price.amount}</span>円</td></tr>)}</tbody></table><div class="price__notes" data-reveal><p>体験レッスンは実施しておりません。<br />ご不明な点は、LINEまたはお電話にてお問い合わせください。</p><a class="inline-link" href={links.reserve} target="_blank" rel="noopener noreferrer">空き状況・ご予約<Icon name="external" /></a></div></div>
      </section>

      <section class="access section-shell" id="access" aria-labelledby="access-title">
        <div class="section-directory"><h2 id="access-title">アクセス</h2><p>自由が丘駅から、徒歩5分。</p></div>
        <div class="access__content"><div class="access__information"><div data-reveal><h3>Pilates studio San<small>ピラティススタジオサン</small></h3><address>〒158-0038<br />東京都世田谷区奥沢7-7-21<br />カーサアビエルタ013</address><p class="access__stations">東急東横線・大井町線 自由が丘駅 徒歩5分<br />東急大井町線 九品仏駅 徒歩7分</p></div><dl data-reveal><div><dt>営業時間</dt><dd>平日 9:00–20:00<br />土日祝 9:00–18:30</dd></div><div><dt>休講日</dt><dd>不定休</dd></div><div><dt>電話番号</dt><dd><a href={links.phone}>090-1497-1628</a></dd></div></dl></div><div class="access__map" data-reveal><iframe title="Pilates studio Sanのアクセスマップ（東京都世田谷区奥沢7-7-21）" src={`https://maps.google.com/maps?q=${mapQuery}&output=embed&z=16`} width="1000" height="500" loading="lazy" referrerpolicy="no-referrer-when-downgrade" tabindex="-1"></iframe></div><a class="inline-link access__map-link" href={links.map} target="_blank" rel="noopener noreferrer">Google Mapsで地図を開く<Icon name="external" /></a></div>
      </section>

      <section class="contact section-shell" id="contact" aria-labelledby="contact-title">
        <div class="contact__intro" data-reveal><p class="small-label">ご予約・お問い合わせ</p><h2 id="contact-title">健やかな日々を、<br />ここから。</h2><p>レッスンのご予約は予約サイトから。<br />ご質問やご相談は、LINEでも承ります。</p></div><div class="contact__links" data-reveal><a href={links.reserve} target="_blank" rel="noopener noreferrer"><span><small>レッスンの空き状況・お申し込み</small>レッスンを予約する</span><span class="link-square"><Icon name="external" /></span></a><a href={links.line} target="_blank" rel="noopener noreferrer"><span><small>ご質問・ご相談</small>LINEでお問い合わせ</span><span class="link-square"><Icon name="external" /></span></a><a class="contact__phone" href={links.phone}><span>お電話でのお問い合わせ</span><span>090-1497-1628</span></a></div>
      </section>
    </main>

    <footer class="site-footer"><div class="site-footer__top"><a href="#top" class="brand" aria-label="Pilates studio San トップへ"><Image class="brand__logo" src={logo} width={88} height={88} alt="" /><span>ピラティススタジオサン</span></a><div class="site-footer__social"><a href={links.instagram} target="_blank" rel="noopener noreferrer">Instagram<Icon name="external" /></a><a href={links.line} target="_blank" rel="noopener noreferrer">LINE<Icon name="external" /></a></div><a class="back-to-top" href="#top">ページの先頭へ<Icon name="down" /></a></div><p class="site-footer__name" aria-hidden="true">Pilates studio San</p><div class="site-footer__bottom"><p>整うからだ、ピラティスで健康に。</p><small>© {new Date().getFullYear()} Pilates studio San</small></div></footer>

    <div class="mobile-booking" aria-label="予約・お問い合わせ"><a href={links.reserve} target="_blank" rel="noopener noreferrer">レッスンを予約する<Icon name="external" /></a><a href={links.line} target="_blank" rel="noopener noreferrer">LINEで相談<Icon name="external" /></a></div>

    <dialog class="lightbox" data-lightbox aria-label="スタジオ写真の拡大表示" data-lenis-prevent><div class="lightbox__toolbar"><span data-lightbox-counter></span><button class="icon-button" type="button" aria-label="写真を閉じる" data-lightbox-close><Icon name="close" /></button></div><div class="lightbox__stage"><button class="icon-button" type="button" aria-label="前の写真" data-lightbox-prev><Icon name="chevron" class="rotate-180" /></button><figure><img data-lightbox-image alt="" /><figcaption data-lightbox-caption></figcaption></figure><button class="icon-button" type="button" aria-label="次の写真" data-lightbox-next><Icon name="chevron" /></button></div></dialog>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
