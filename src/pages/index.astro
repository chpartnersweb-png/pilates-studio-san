---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import logo from '../assets/logo-transparent.png';
import { links, navigation, photos, gallery, prices } from '../data/studio';
import '../styles/global.css';

const title = '自由が丘・九品仏のプライベートピラティス｜Pilates studio San';
const description = '自由が丘駅徒歩5分・九品仏駅徒歩7分、世田谷区奥沢のPilates studio San。完全プライベート空間で、お身体や目的に合わせたピラティスを。1回8,500円、5回・10回の回数券あり。料金・インストラクター・アクセス・ご予約をご案内します。';
if (!Astro.site) throw new Error('astro.config.mjs に公開URL（site）を設定してください。');
const siteUrl = Astro.site.href;
const canonical = new URL('/', Astro.site).href;
const socialImage = new URL('/ogp.jpg', Astro.site).href;
const studioId = new URL('#studio', Astro.site).href;
const websiteId = new URL('#website', Astro.site).href;
const webpageId = new URL('#webpage', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: 'Pilates studio San',
      alternateName: 'ピラティススタジオサン',
      inLanguage: 'ja',
      publisher: { '@id': studioId },
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonical,
      name: title,
      description,
      inLanguage: 'ja',
      isPartOf: { '@id': websiteId },
      mainEntity: { '@id': studioId },
    },
    {
      '@type': 'ExerciseGym',
      '@id': studioId,
      name: 'Pilates studio San',
      alternateName: 'ピラティススタジオサン',
      url: canonical,
      description: '自由が丘駅徒歩5分・九品仏駅徒歩7分。大人の方を対象に、お一人おひとりのお身体や目的に合わせたピラティスセッションを行う完全プライベートのスタジオです。休講日は不定休です。',
      telephone: '+81-90-1497-1628',
      logo: new URL(logo.src, Astro.site).href,
      image: [gallery[0].image, photos.studioDetail, photos.machineLesson].map((photo) => new URL(photo.src, Astro.site).href),
      address: {
        '@type': 'PostalAddress',
        postalCode: '158-0038',
        addressRegion: '東京都',
        addressLocality: '世田谷区',
        streetAddress: '奥沢7-7-21 カーサアビエルタ013',
        addressCountry: 'JP',
      },
      hasMap: links.map,
      sameAs: [links.instagram, links.line],
      priceRange: '¥8,500〜¥75,000',
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '09:00',
          closes: '20:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Saturday', 'Sunday'],
          opens: '09:00',
          closes: '18:30',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'https://schema.org/PublicHolidays',
          opens: '09:00',
          closes: '18:30',
        },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'プライベートピラティスのレッスン料金',
        itemListElement: prices.map((price) => ({
          '@type': 'Offer',
          name: price.title,
          description: price.count === '1' ? 'プライベートレッスン1回。体験レッスンは実施しておりません。' : `${price.count}回分のプライベートレッスン。${price.validity}。`,
          price: price.amount.replaceAll(',', ''),
          priceCurrency: 'JPY',
          url: new URL('#price', Astro.site).href,
          itemOffered: {
            '@type': 'Service',
            name: `プライベートピラティス ${price.title}`,
            serviceType: 'プライベートピラティス',
            provider: { '@id': studioId },
          },
        })),
      },
    },
  ],
};
// Escape HTML-significant characters before embedding JSON in a script element.
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
const mapQuery = encodeURIComponent('Pilates studio San 東京都世田谷区奥沢7-7-21 カーサアビエルタ');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#eeedea" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Pilates studio San" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content="Pilates studio Sanのロゴ" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Pilates studio Sanのロゴ" />
    <script type="application/ld+json" is:inline set:html={structuredDataJson} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Noto+Sans+JP:wght@400;500;600&family=Noto+Serif+JP:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <header class="site-header" data-header>
      <a class="brand" href="#top" aria-label="Pilates studio San トップへ">
        <Image class="brand__logo" src={logo} width={88} height={88} alt="" loading="eager" />
        <span class="brand__wordmark">Pilates studio <span>San</span></span>
      </a>
      <nav class="desktop-nav" aria-label="メインナビゲーション">
        {navigation.map((item) => <a href={item.href}><span>{item.en}</span><small>{item.label}</small></a>)}
      </nav>
      <a class="header-reserve" href={links.reserve} target="_blank" rel="noopener noreferrer"><span>レッスンを予約する</span><Icon name="external" /></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="メニューを開く" data-menu-open><span></span><span></span></button>
    </header>

    <dialog class="mobile-menu" id="mobile-menu" aria-label="ナビゲーションメニュー" data-mobile-menu data-lenis-prevent>
      <div class="mobile-menu__top"><span class="eyebrow">Pilates studio San</span><button class="icon-button" type="button" aria-label="メニューを閉じる" data-menu-close><Icon name="close" /></button></div>
      <nav aria-label="モバイルナビゲーション">
        {navigation.map((item, i) => <a href={item.href}><span class="mobile-menu__number">0{i + 1}</span><span class="mobile-menu__name">{item.en}<small>{item.label}</small></span><Icon name="external" /></a>)}
      </nav>
      <a class="button button--coral" href={links.reserve} target="_blank" rel="noopener noreferrer">レッスンを予約する<Icon name="external" /></a>
      <a class="mobile-menu__line" href={links.line} target="_blank" rel="noopener noreferrer">LINEでお問い合わせ<Icon name="external" /></a>
    </dialog>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow hero__eyebrow" data-hero-reveal><span class="tiny-sun" aria-hidden="true"></span>JIYUGAOKA · PRIVATE PILATES</p>
          <h1 id="hero-title"><span class="hero__line"><span data-hero-line>整うからだ、</span></span><span class="hero__line"><span data-hero-line>ピラティスで</span></span><span class="hero__line hero__line--coral"><span data-hero-line>健康に。</span></span></h1>
          <p class="hero__description" data-hero-reveal>自分のからだと、ていねいに向き合う。<br />自由が丘の、プライベートピラティス。</p>
          <a class="button button--coral hero__button" href={links.reserve} target="_blank" rel="noopener noreferrer" data-hero-reveal>レッスンを予約する<Icon name="external" /></a>
          <p class="hero__location" data-hero-reveal>自由が丘駅 徒歩5分 <span>/</span> 九品仏駅 徒歩7分</p>
        </div>
        <div class="hero__visual" data-hero-visual>
          <div class="hero__image-wrap">
            <Image class="hero__image" src={photos.machineLesson} alt="木製のピラティスマシンを使い、からだをしなやかに動かすレッスン風景" width={1568} height={1044} widths={[640, 960, 1280, 1568]} sizes="(max-width: 767px) 100vw, 58vw" format="webp" loading="eager" fetchpriority="high" />
            <span class="hero__image-label">A moment for yourself.</span>
          </div>
          <div class="hero__caption"><span>YOUR BODY. YOUR PACE.</span><span>01 — SAN</span></div>
        </div>
        <a class="hero__scroll" href="#about"><span>SCROLL TO DISCOVER</span><span class="hero__scroll-line" aria-hidden="true"></span></a>
      </section>

      <section class="about section-pad" id="about" aria-labelledby="about-title">
        <div class="section-heading" data-reveal><p class="eyebrow"><span class="section-index">01</span>ABOUT SAN</p><p class="section-heading__note">自分のための、ひととき。</p></div>
        <div class="about__layout">
          <div class="about__visual" data-reveal><div class="image-frame about__photo"><Image src={photos.studioDetail} alt="スタジオに飾られたグリーンとSanのサイン" width={1706} height={960} widths={[480, 800, 1200]} sizes="(max-width: 767px) 88vw, 42vw" format="webp" data-parallax /></div><span class="about__handwriting" aria-hidden="true">Just for you.</span><p class="photo-caption">小さなスタジオで、からだに向き合う大切な時間を。</p></div>
          <div class="about__copy" data-reveal><h2 class="japanese-title" id="about-title">無理なく、心地よく。<br />自分らしい健やかさへ。</h2><p>忙しい毎日の中で、<br />自分のからだを感じる時間はありますか。</p><p>Pilates studio Sanは、自由が丘にある<br class="desktop-break" />完全プライベートのピラティススタジオです。</p><p>一人ひとり異なる、からだと目的。<br />その日のあなたに合わせたセッションを通じて、<br class="desktop-break" />無理なく続けられる、健やかな毎日を目指します。</p><a class="text-link" href="#lesson">Sanのレッスンについて<Icon name="arrow" /></a></div>
        </div>
      </section>

      <section class="lesson section-pad" id="lesson" aria-labelledby="lesson-title">
        <div class="section-heading" data-reveal><p class="eyebrow"><span class="section-index">02</span>OUR LESSON</p><p class="section-heading__note">あなたのからだに、あなたのペースで。</p></div>
        <div class="lesson__layout">
          <div class="lesson__intro"><h2 class="japanese-title" id="lesson-title" data-reveal>からだの声を聞く、<br />あなただけのレッスン。</h2><div class="lesson__photo image-frame" data-reveal><Image src={photos.matLesson} alt="マットの上でバランスを取りながら行うピラティスのエクササイズ" width={1205} height={1359} widths={[480, 720, 1000]} sizes="(max-width: 767px) 88vw, 38vw" format="webp" data-parallax /><span class="photo-tag">PRIVATE SESSION</span></div></div>
          <div class="lesson__details">
            <p class="lesson__lead" data-reveal>誰かと比べず、自分に集中する。<br />Sanが大切にしている、3つのこと。</p>
            <article class="lesson-feature" data-reveal><span class="lesson-feature__number">01</span><div><p class="eyebrow">PRIVATE</p><h3>完全プライベートの空間</h3><p>周りを気にせず、自分のからだに意識を向ける。落ち着いた空間で、一人ひとりに向き合うセッションを行います。</p></div></article>
            <article class="lesson-feature" data-reveal><span class="lesson-feature__number">02</span><div><p class="eyebrow">PERSONAL</p><h3>からだと目的に合わせて</h3><p>お身体の状態や目指すことに合わせて、マシンやマットを使いながら、あなたのためのピラティスをお届けします。</p></div></article>
            <article class="lesson-feature" data-reveal><span class="lesson-feature__number">03</span><div><p class="eyebrow">YOUR PACE</p><h3>無理なく続けて、より健康に</h3><p>大切なのは、心地よく続けられること。ご自身のペースでからだを動かし、日々の健康につなげていきましょう。</p></div></article>
            <p class="lesson__audience" data-reveal><span>対象</span>大人の方に向けたプライベートレッスン</p>
          </div>
        </div>
      </section>

      <section class="gallery-section" aria-labelledby="gallery-title">
        <div class="gallery-heading section-inline" data-reveal><div><p class="eyebrow">A GLIMPSE OF SAN</p><h2 class="english-title" id="gallery-title">Inside the studio<span class="coral-dot">.</span></h2></div><div class="gallery-controls"><span class="gallery-hint">写真をタップして拡大</span><button class="icon-button" type="button" aria-label="前の写真へスクロール" data-gallery-prev><Icon class="rotate-180" name="arrow" /></button><button class="icon-button" type="button" aria-label="次の写真へスクロール" data-gallery-next><Icon name="arrow" /></button></div></div>
        <div class="gallery-track" data-gallery-track data-lenis-prevent-horizontal tabindex="0" role="region" aria-label="スタジオの写真ギャラリー。横にスクロールできます">
          {gallery.map((photo, index) => <figure class="gallery-item"><button class="gallery-item__button" type="button" data-gallery-image data-source={photo.image.src} data-title={photo.label} data-alt={photo.alt} aria-label={`${photo.label}の写真を拡大`}><Image src={photo.image} alt={photo.alt} width={photo.image.width} height={photo.image.height} widths={[320, 600, 900]} sizes="(max-width: 767px) 72vw, 300px" format="webp" style={`object-position: ${photo.position}`} /><span class="gallery-item__expand" aria-hidden="true">View<Icon name="external" /></span></button><figcaption><span>{String(index + 1).padStart(2, '0')}</span>{photo.label}</figcaption></figure>)}
        </div>
        <p class="gallery-footnote section-inline">STUDIO, EQUIPMENT & EVERYDAY MOMENTS <span>ゆっくり横にスクロールしてご覧ください <Icon name="arrow" /></span></p>
      </section>

      <section class="price section-pad" id="price" aria-labelledby="price-title">
        <div class="section-heading" data-reveal><p class="eyebrow"><span class="section-index">03</span>PRICE</p><p class="section-heading__note">あなたのペースで、続けられるように。</p></div>
        <div class="price__intro" data-reveal><h2 class="japanese-title" id="price-title">健やかな日々に、<br />ピラティスという習慣を。</h2><p>1回ごとのレッスンと、継続して通うための回数券。<br class="desktop-break" />ライフスタイルに合わせてお選びいただけます。</p></div>
        <div class="price-list">{prices.map((price) => <article class="price-plan" data-reveal><p class="price-plan__eyebrow">{price.english}</p><div class="price-plan__count"><span>{price.count}</span>{price.unit}</div><h3>{price.title}</h3><p class="price-plan__amount"><span class="price-plan__yen">¥</span>{price.amount}</p><p class="price-plan__per">{price.perSession}</p><p class="price-plan__validity">{price.validity}</p></article>)}</div>
        <div class="price__bottom" data-reveal><p>※体験レッスンは実施しておりません。<br />ご不明な点は、LINEまたはお電話にてお問い合わせください。</p><a class="text-link" href={links.reserve} target="_blank" rel="noopener noreferrer">空き状況・ご予約はこちら<Icon name="external" /></a></div>
      </section>

      <section class="instructor section-pad" id="instructor" aria-labelledby="instructor-title">
        <div class="section-heading" data-reveal><p class="eyebrow"><span class="section-index">04</span>INSTRUCTOR</p><p class="section-heading__note">一人ひとりに、ていねいに。</p></div>
        <div class="instructor__layout">
          <div class="instructor__portrait" data-reveal><div class="image-frame"><Image src={photos.instructor} alt="Pilates studio San インストラクター 山口千恵子" width={960} height={1706} widths={[480, 720, 960]} sizes="(max-width: 767px) 80vw, 32vw" format="webp" /></div><span class="instructor__script" aria-hidden="true">Chieko Yamaguchi</span></div>
          <div class="instructor__profile" data-reveal><p class="eyebrow">YOUR INSTRUCTOR</p><h2 id="instructor-title">山口 千恵子<span>Chieko Yamaguchi</span></h2><p class="instructor__intro">一人ひとりのお身体や目的に合わせて。<br />あなたの健やかな毎日を、<br />ピラティスを通してサポートします。</p><div class="qualifications"><h3>資格・認定<span>QUALIFICATIONS</span></h3><ul><li><span>PEAK PILATES</span>Full Comprehensive Certification</li><li><span>BODY CONTROL PILATES</span>産後のためのリカバリーピラティス</li><li><span>公益財団法人 健康・体力づくり事業財団</span>健康運動指導士</li></ul></div><a class="text-link" href={links.instagram} target="_blank" rel="noopener noreferrer"><span class="text-link__icon"><Icon name="instagram" />InstagramでSanの日々を見る</span><Icon name="external" /></a></div>
        </div>
      </section>

      <section class="access section-pad" id="access" aria-labelledby="access-title">
        <div class="section-heading" data-reveal><p class="eyebrow"><span class="section-index">05</span>ACCESS</p><p class="section-heading__note">自由が丘から、歩いて5分。</p></div>
        <div class="access__layout">
          <div class="access__info" data-reveal><h2 class="english-title" id="access-title">Come say hello<span class="coral-dot">.</span></h2><p class="access__name">Pilates studio San<span>ピラティススタジオサン</span></p><address>〒158-0038<br />東京都世田谷区奥沢7-7-21<br />カーサアビエルタ013</address><dl class="access__details"><div><dt>アクセス</dt><dd>東急東横線・大井町線<br /><strong>自由が丘駅 徒歩5分</strong><br />東急大井町線 <strong>九品仏駅 徒歩7分</strong></dd></div><div><dt>営業時間</dt><dd>平日 <span class="access__hours">9:00–20:00</span><br />土日祝 <span class="access__hours">9:00–18:30</span></dd></div><div><dt>休講日</dt><dd>不定休</dd></div><div><dt>電話番号</dt><dd><a class="phone-link" href={links.phone}>090-1497-1628</a></dd></div></dl><a class="text-link" href={links.map} target="_blank" rel="noopener noreferrer"><span class="text-link__icon"><Icon name="pin" />Google Mapsで開く</span><Icon name="external" /></a></div>
          <div class="access__map" data-reveal><iframe title="Pilates studio Sanへのアクセスマップ（東京都世田谷区奥沢7-7-21）" src={`https://maps.google.com/maps?q=${mapQuery}&output=embed&z=16`} width="720" height="640" loading="lazy" referrerpolicy="no-referrer-when-downgrade" tabindex="-1"></iframe><a class="access__map-link" href={links.map} target="_blank" rel="noopener noreferrer" aria-label="Google MapsでPilates studio Sanの地図を開く">Pilates studio San<Icon name="external" /></a></div>
        </div>
      </section>

      <section class="contact section-pad" id="contact" aria-labelledby="contact-title">
        <div class="contact__ornament" aria-hidden="true"></div><div class="contact__copy" data-reveal><p class="eyebrow">RESERVATION & CONTACT</p><h2 id="contact-title">自分のからだに、<br />向き合う時間を。</h2><p>レッスンのご予約は、予約サイトから。<br />ご質問・ご相談は、LINEでお気軽にどうぞ。</p></div><div class="contact__actions" data-reveal><a class="button button--cream" href={links.reserve} target="_blank" rel="noopener noreferrer"><span><small>ONLINE RESERVATION</small>レッスンを予約する</span><Icon name="external" /></a><a class="button button--outline" href={links.line} target="_blank" rel="noopener noreferrer"><span><small>OFFICIAL LINE</small>LINEでお問い合わせ</span><Icon name="external" /></a><a class="contact__phone" href={links.phone}><Icon name="phone" /><span>090-1497-1628</span></a></div>
      </section>
    </main>

    <footer class="site-footer section-inline"><div class="site-footer__main"><a class="brand brand--footer" href="#top" aria-label="Pilates studio San トップへ"><Image class="brand__logo" src={logo} alt="" width={120} height={120} /><span class="brand__wordmark">Pilates studio <span>San</span><small>整うからだ、ピラティスで健康に。</small></span></a><div class="site-footer__links"><a href={links.instagram} target="_blank" rel="noopener noreferrer">Instagram<Icon name="external" /></a><a href={links.line} target="_blank" rel="noopener noreferrer">LINE<Icon name="external" /></a><a href={links.reserve} target="_blank" rel="noopener noreferrer">Reservation<Icon name="external" /></a></div><a class="back-to-top" href="#top" aria-label="ページの先頭へ"><Icon name="arrow" /></a></div><div class="site-footer__bottom"><p>© {new Date().getFullYear()} Pilates studio San</p><span>MOVE WELL. LIVE WELL.</span></div></footer>

    <div class="mobile-booking" aria-label="予約・お問い合わせ"><a href={links.reserve} target="_blank" rel="noopener noreferrer">レッスンを予約する<Icon name="external" /></a><a href={links.line} target="_blank" rel="noopener noreferrer">LINEで相談<Icon name="external" /></a></div>

    <dialog class="lightbox" data-lightbox aria-label="スタジオ写真の拡大表示" data-lenis-prevent><div class="lightbox__toolbar"><span data-lightbox-counter></span><button class="icon-button" type="button" aria-label="写真を閉じる" data-lightbox-close><Icon name="close" /></button></div><div class="lightbox__stage"><button class="icon-button" type="button" aria-label="前の写真" data-lightbox-prev><Icon name="chevron" class="rotate-180" /></button><figure><img data-lightbox-image alt="" /><figcaption data-lightbox-caption></figcaption></figure><button class="icon-button" type="button" aria-label="次の写真" data-lightbox-next><Icon name="chevron" /></button></div></dialog>

